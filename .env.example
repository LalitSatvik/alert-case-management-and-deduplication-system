# Database role passwords. `docker/postgres/init/01-roles.sh` reads
# POSTGRES_OWNER_PASSWORD / POSTGRES_APP_PASSWORD on first-boot init to create the
# roles; the two DSNs below must embed the SAME values. Change all four together
# (before the first `up` — the init script only runs on an empty data directory).
POSTGRES_OWNER_PASSWORD=owner_pw
POSTGRES_APP_PASSWORD=app_pw
POSTGRES_SUPERUSER_PASSWORD=bootstrap
DATABASE_URL=postgresql+asyncpg://app_user:app_pw@postgres:5432/acms
MIGRATION_DATABASE_URL=postgresql+asyncpg://acms_owner:owner_pw@postgres:5432/acms
REDIS_URL=redis://valkey:6379/0
JWT_SECRET=change-me-in-real-deployments
ENVIRONMENT=local

# Caddy site address.
#   http://localhost   -> local HTTP, no cert (also the value to use when a
#                         Cloudflare Tunnel terminates TLS upstream).
#   acms.example.com    -> bare hostname; Caddy provisions and renews HTTPS.
SITE_ADDRESS=http://localhost

# Phase 2 (object storage) — Garage, not wired yet.
# The app does not read these in the MVP; uncomment and fill when attachments land.
# MINIO_ENDPOINT=garage:3900
# MINIO_ACCESS_KEY=change-me
# MINIO_SECRET_KEY=change-me
# MINIO_BUCKET=acms
